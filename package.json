{
  "name": "n8n-nodes-gorgias",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Gorgias e-commerce helpdesk providing 14 resources and 90+ operations for ticket management, customer support, team collaboration, and automation.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-gorgias.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-gorgias#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-gorgias/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "gorgias",
    "helpdesk",
    "customer-support",
    "e-commerce",
    "shopify",
    "magento",
    "bigcommerce",
    "tickets",
    "automation",
    "support",
    "crm"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GorgiasApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Gorgias/Gorgias.node.js",
      "dist/nodes/Gorgias/GorgiasTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.0"
  }
}